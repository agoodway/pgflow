#!/usr/bin/env bash
set -euo pipefail
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

pid=""
for candidate in $(pgrep -f 'hivemind Procfile.dev' || true); do
  cwd=$(lsof -a -p "$candidate" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' || true)
  if [ "$cwd" = "$REPO_DIR" ]; then
    pid="$candidate"
    break
  fi
done

if [ -n "$pid" ]; then
  kill -INT "$pid" 2>/dev/null || true
  for _ in $(seq 1 10); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
fi

pkill -f 'beam.*pgflow_demo' 2>/dev/null || true
docker compose stop >/dev/null 2>&1 || true

echo "pgflow: stopped"
