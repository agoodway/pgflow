# PgFlow Demo — Environment Variables
#
# Copy this file to `.env` (gitignored) and fill in your secrets.
# Shared, non-secret defaults live in `.env.dev` (committed).
# Real env vars always override file values.

# Phoenix
PORT=4022

# AI (Fireworks AI — OpenAI-compatible endpoint)
AI_API_KEY=your-fireworks-key-here
AI_API_BASE=https://api.fireworks.ai/inference/v1
AI_MODEL_NAME=accounts/fireworks/models/deepseek-v3p2
